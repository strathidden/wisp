#version 460 core
layout(local_size_x = 16, local_size_y = 16) in;
layout(rgba32f, binding = 0) uniform image2D outputTex;

uniform int fractalType;
uniform int iterations;
uniform float power;
uniform vec3 juliaSeed;
uniform vec3 fractalColor;
uniform float glowStrength;
uniform float specular;
uniform float aoStrength;
uniform float shadowStrength;
uniform int maxSteps;
uniform float stepScale;
uniform float minDistance;
uniform bool enableAO;
uniform bool enableShadows;
uniform bool enableGlow;

uniform mat4 view;
uniform mat4 proj;
uniform vec3 cameraPos;
uniform vec3 lightDir = normalize(vec3(0.8, 1.0, 0.6));

float mandelbulbDE(vec3 pos) {
    vec3 z = pos;
    float dr = 1.0;
    float r = 0.0;
    
    for (int i = 0; i < iterations; i++) {
        r = length(z);
        if (r > 4.0) break;
        
        // Polar coordinates optimization
        float theta = acos(z.z / r);
        float phi = atan(z.y, z.x);
        dr = pow(r, power - 1.0) * power * dr + 1.0;
        
        float zr = pow(r, power);
        theta *= power;
        phi *= power;
        
        // Avoid expensive sin/cos where possible
        float sinTheta = sin(theta);
        z = zr * vec3(sinTheta * cos(phi), sin(phi) * sinTheta, cos(theta));
        z += pos;
    }
    
    return 0.5 * log(r) * r / dr;
}

float juliaDE(vec3 pos) {
    vec3 c = juliaSeed;
    vec3 z = pos;
    float dr = 1.0;
    float r = 0.0;
    
    for (int i = 0; i < iterations; i++) {
        r = length(z);
        if (r > 4.0) break;
        
        float theta = acos(z.z / r);
        float phi = atan(z.y, z.x);
        dr = pow(r, power - 1.0) * power * dr + 1.0;
        
        float zr = pow(r, power);
        theta *= power;
        phi *= power;
        
        float sinTheta = sin(theta);
        z = zr * vec3(sinTheta * cos(phi), sin(phi) * sinTheta, cos(theta));
        z += c;
    }
    
    return 0.5 * log(r) * r / dr;
}

float map(vec3 pos) {
    return (fractalType == 0) ? mandelbulbDE(pos) : juliaDE(pos);
}

// Tetrahedron 4 DE calls
vec3 calcNormal(vec3 pos) {
    const float eps = 0.001;
    const vec2 k = vec2(1.0, -1.0);
    return normalize(k.xyy * map(pos + k.xyy*eps) + 
                    k.yyx * map(pos + k.yyx*eps) + 
                    k.yxy * map(pos + k.yxy*eps) + 
                    k.xxx * map(pos + k.xxx*eps));
}

float calcAO(vec3 pos, vec3 normal) {
    if (!enableAO) return 1.0;
    
    float occ = 0.0;
    float sca = 1.0;
    for (int i = 0; i < 3; i++) {
        float hr = 0.01 + 0.05 * float(i);
        occ += -(map(pos + normal * hr) - hr) * sca;
        sca *= 0.85;
    }
    return clamp(1.0 - aoStrength * occ, 0.0, 1.0);    
}

float softShadow(vec3 ro, vec3 rd, float tmin, float tmax) {
    if (!enableShadows) return 1.0;
    
    float res = 1.0;
    float t = tmin;
    for (int i = 0; i < 16; i++) {
        float h = map(ro + rd * t);
        if (h < minDistance) 
            return 0.0;
            
        res = min(res, shadowStrength * h / t);
        t += h;
        if (t >= tmax) break;
    }
    return res;
}

void main() {
    ivec2 texCoord = ivec2(gl_GlobalInvocationID.xy);
    ivec2 size = imageSize(outputTex);
    if (texCoord.x >= size.x || texCoord.y >= size.y) return;
    
    vec2 uv = vec2(texCoord) / vec2(size);
    uv = uv * 2.0 - 1.0;
    
    vec4 rayClip = vec4(uv, -1.0, 1.0);
    vec4 rayEye = inverse(proj) * rayClip;
    rayEye = vec4(rayEye.xy, -1.0, 0.0);

    vec3 rayWorld = normalize(vec3(inverse(view) * rayEye));
    
    vec3 col = vec3(0.0);
    vec3 pos = cameraPos;
    float t = 0.0;
    float glow = 0.0;
    const float MAX_DIST = 100.0;
    bool hit = false;
    
    for (int i = 0; i < maxSteps; i++) {
        vec3 p = pos + t * rayWorld;
        float d = map(p) * stepScale;
        
        if (d < minDistance) {
            hit = true;
            vec3 normal = calcNormal(p);
            float ao = calcAO(p, normal);
            float diff = max(dot(normal, lightDir), 0.0);
            
            float shadow = softShadow(p + normal * minDistance * 2.0, lightDir, 0.02, 10.0);
            
            vec3 reflectDir = reflect(-lightDir, normal);
            float spec = pow(max(dot(rayWorld, reflectDir), 0.0), 32.0) * specular;
            
            col = fractalColor * (diff + 0.2) * ao * shadow;
            col += vec3(0.8) * spec * shadow;
            if (enableGlow) {
                col += glow * vec3(1.0, 0.6, 0.3) * glowStrength;
            }
            break;
        }
        
        if (t > MAX_DIST) {
            col = vec3(0.1, 0.2, 0.4) * 0.5;
            break;
        }
        
        t += d;
        if (enableGlow) {
            glow += 0.01 / (1.0 + d * 20.0);
        }
    }
    
    col = col / (col + 1.0);
    col = pow(col, vec3(1.0/2.2));
    
    imageStore(outputTex, texCoord, vec4(col, 1.0));
}
